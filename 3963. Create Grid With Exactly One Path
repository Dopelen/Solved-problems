"""You can see the description of the task using the code specified in the title on leetcode.
This program has O(n * m) complexity by time and O(n * m) by space.

The task is to construct any matrix that contains a valid path. 
You don’t need to overcomplicate the construction; you can simply build one where the path runs along the edge of the matrix.
"""

class Solution:
    def createGrid(self, m: int, n: int) -> list[str]:
        return [('.' + '#' * (n - 1)) for _ in range(m - 1)] + ["." * n]
