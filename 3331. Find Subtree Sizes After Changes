"""You can see the description of the task using the code specified in the title on leetcode.
This program has O(n) complexity by time and O(n) by space.

A rather unpleasant medium-level problem. 
My initial approach - iterating through all the nodes, rearranging them, and then constructing the result - didn't work; 
it was clear from an asymptotic standpoint that it wouldn't.
The correct solution involves traversing down the tree while keeping track of subtree sizes and identifying the appropriate child node at each step.
"""

class Solution:
    def findSubtreeSizes(self, parent: List[int], s: str) -> List[int]:
        size = len(parent)
        kids = [[] for _ in range(size)]

        for i in range(1, size):
            kids[parent[i]].append(i)

        new_parent = parent[:]
        answer = [1] * size
        last = [-1] * 26
        saved = [-1] * size
        stack = [(0, False)]

        while stack:
            node, exiting = stack.pop()
            c = ord(s[node]) - 97
            if exiting:
                last[c] = saved[node]
                if new_parent[node] != -1:
                    answer[new_parent[node]] += answer[node]
                continue
            if last[c] != -1:
                new_parent[node] = last[c]
            saved[node] = last[c]
            last[c] = node
            stack.append((node, True))
            for child in kids[node]:
                stack.append((child, False))

        return answer
