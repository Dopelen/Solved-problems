"""You can see the description of the task using the code specified in the title on leetcode.
This program has O(n * sqrt(n)) complexity by time and O(n) by space.

The first part, involving the search for divisors, is fairly straightforward.

The second part concerns how to perform rotations in better than quadratic time; 
for this, we use the KMP (Knuth-Morris-Pratt) algorithm. 
Essentially, the problem becomes solvable once we’ve figured out how to efficiently find divisors (with sqrt) and quickly check for the occurrence of a string.

Unfortunately, I didn't manage to get it done within an hour.
"""

# https://leetcode.com/problems/sum-of-sortable-integers/editorial/?envType=daily-question&envId=2026-10-20
class Solution:
    def sortableIntegers(self, nums: List[int]) -> int:
        size = len(nums)
        factors = []
        
        for x in range(1, math.isqrt(size) + 1):
            if size % x == 0:
                factors.append(x)
                if size // x != x:
                    factors.append(size // x)
        target = sorted(nums)

        def kmp(nums1, nums2):
            n, m = len(nums1), len(nums2)
            pi = [0] * m
            j = 0
            for i in range(1, m):
                while j > 0 and nums2[i] != nums2[j]:
                    j = pi[j - 1]
                if nums2[i] == nums2[j]:
                    j += 1
                pi[i] = j
            j = 0
            for i in range(n):
                while j > 0 and nums1[i] != nums2[j]:
                    j = pi[j - 1]
                if nums1[i] == nums2[j]:
                    j += 1
                if j == m:
                    return True
            return False

        def check(nums1, nums2):
            return kmp(nums1 + nums1, nums2)

        ans = 0
        for d in factors:
            for left in range(0, size, d):
                right = left + d - 1
                if not check(nums[left : right + 1], target[left : right + 1]):
                    break
            else:
                ans += d
        return ans
