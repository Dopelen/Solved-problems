"""You can see the description of the task using the code specified in the title on leetcode.
This program has O(n * m) complexity by time and O(n) by space.

I honestly didn't expect my naive approach to be accepted - let alone to rank in the top 83% in terms of execution speed.

I implemented a dynamic programming solution that tracks all possible XOR values. 
Later, I realized it could be optimized for memory: we only need the current and previous rows to calculate everything required.
"""

# OPTIMIZED!
class Solution:
    def minCost(self, grid: list[list[int]]) -> int:
        rows,cols = len(grid), len(grid[0])
        previous = [grid[0][0]]
        for i in range(1, cols):
            previous.append(previous[-1] ^ grid[0][i])
        previous = [{elem} for elem in previous]

        for row in range(1, rows):
            current = []
            for col in range(cols):
                xor_to_process = previous[col] | (current[-1] if current else set())
                current.append({grid[row][col] ^ elem for elem in xor_to_process})
            previous = current

        return min(previous[-1]) if rows == 1 else min(current[-1])


# Initial version!
class Solution:
    def minCost(self, grid: list[list[int]]) -> int:
        rows,cols = len(grid), len(grid[0])
        dp = [[set() for _ in range(cols)] for _ in range(rows)]
        for row in range(rows):
            for col in range(cols):
                possible_xor = set()
                if row != 0:
                    possible_xor |= dp[row - 1][col]
                if col != 0:
                    possible_xor |= dp[row][col - 1]
                dp[row][col] = {grid[row][col] ^ elem for elem in possible_xor} or {grid[row][col]}
        return min(dp[-1][-1])
