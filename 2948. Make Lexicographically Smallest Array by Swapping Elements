# even shorter
class Solution:
    def lexicographicallySmallestArray(self, nums: List[int], limit: int) -> List[int]:
        n = len(nums)
        order = sorted(range(n), key=nums.__getitem__)
        res = [0] * n
        start = 0
        for k in range(1, n + 1):
            if k == n or nums[order[k]] - nums[order[k - 1]] > limit:
                for pos, i in enumerate(sorted(order[start:k])):
                    res[i] = nums[order[start + pos]]
                start = k

        return res


# correct ones
class Solution:
    def lexicographicallySmallestArray(self, nums: List[int], limit: int) -> List[int]:
        size = len(nums)
        nums2, indices, result = sorted([(nums[i], i) for i in range(size)]), [], [0] * size
        for i in range(size):
            if i == 0 or nums2[i][0] - nums2[i - 1][0] > limit:
                indices.append([])
            indices[-1].append(nums2[i][1])
        for index in indices:
            sorted_index = sorted(index)
            for j in range(len(index)):
                result[sorted_index[j]] = nums[index[j]]
        return result



# bruteforce try
class Solution:
    def lexicographicallySmallestArray(self, nums: List[int], limit: int) -> List[int]:
        num_to_idx: dict = defaultdict(list)
        nums_for_process = nums.copy()

        for idx, num in enumerate(nums):
            num_to_idx[num].append(idx)

        def change_nums(nums_to_swap: list) -> None:
            idx_to_swap = sum([num_to_idx[elem] for elem in set(nums_to_swap)], [])
            idx_to_swap.sort()
            for idx, elem in zip(idx_to_swap, nums_to_swap):
                nums[idx] = elem

        nums_for_process.sort()
        nums_for_process.append(2 * 10 ** 9 + 1)
        idx = 0
        cur_cluster = [nums_for_process[idx]]

        while idx < len(nums):
            if nums_for_process[idx + 1] - nums_for_process[idx] <= limit:
                cur_cluster.append(nums_for_process[idx + 1])
            else:
                change_nums(cur_cluster)
                cur_cluster = [nums_for_process[idx + 1]]
            idx += 1

        return nums

