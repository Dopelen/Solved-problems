"""You can see the description of the task using the code specified in the title on leetcode.
This program has O(n) complexity by time and O(n) by space.

It turned out more cumbersome than I intended, but I don't think it can be done more simply.
We need to proceed from both ends, tracking the maximum and minimum - that’s two passes.
Then we compare the values ​​from left to right - that’s another one.
"""

class Solution:
    def firstStableIndex(self, nums: list[int], k: int) -> int:
        size = len(nums)
        cur_min = math.inf
        cur_max = -math.inf
        max_arr = [0] * size
        min_arr = [0] * size

        for i in range(len(nums)):
            cur_max = max(cur_max, nums[i])
            max_arr[i] = cur_max
            cur_min = min(cur_min, nums[~i])
            min_arr[~i] = cur_min
        
        for idx, (max_elem, min_elem) in enumerate(zip(max_arr, min_arr)):
            if max_elem - min_elem <= k:
                return idx
        
        return -1
