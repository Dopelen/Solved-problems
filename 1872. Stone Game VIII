class Solution:
    def stoneGameVIII(self, stones: List[int]) -> int:
        size = len(stones)
        prefix_sum = list(accumulate(stones))
        max_dif = [0] * size
        max_dif[size - 1] = prefix_sum[size - 1]
        for i in range(size - 2, 0, -1):
            max_dif[i] = max(max_dif[i + 1], prefix_sum[i] - max_dif[i + 1])
        return max_dif[1]
