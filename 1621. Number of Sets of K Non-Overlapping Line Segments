# https://leetcode.com/problems/number-of-sets-of-k-non-overlapping-line-segments/solutions/8508452/number-of-sets-of-k-non-overlapping-line-njts/?envType=daily-question&envId=2026-09-16
class Solution:
    def numberOfSets(self, n: int, k: int) -> int:
        return math.comb(n + k - 1, k * 2) % (10**9 + 7)
