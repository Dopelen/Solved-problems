"""You can see the description of the task using the code specified in the title on leetcode.
This program has O(n) complexity by time and O(n) by space.

I quickly figured out how to solve it, but actually writing the code was really tough; 
I kept getting mixed up with the sums and the even/odd logic, but in the end, it all worked out - and it even passed all the tests on the first try.
"""

class Solution:
    def waysToMakeFair(self, nums: List[int]) -> int:
        size: int = len(nums)
        total_odd_sum: int = sum(nums[i] for i in range(size) if i % 2)
        total_even_sum: int = sum(nums[i] for i in range(size) if not (i % 2))
        fair: int = 0
        cur_even_sum: int = 0
        cur_odd_sum: int = 0
        odd: bool = False

        for i in range(size):
            if odd:
                cur_odd_sum += nums[i]
            else:
                cur_even_sum += nums[i]
            fair += ((total_even_sum - cur_even_sum + cur_odd_sum - (nums[i] if odd else 0)) ==
                     (total_odd_sum - cur_odd_sum + cur_even_sum - (0 if odd else nums[i])))

            odd = not odd

        return fair
