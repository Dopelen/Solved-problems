class Solution:
    def uniformArray(self, nums1: list[int]) -> bool:
        size = len(nums1)
        odd_counter = sum(1 for elem in nums1 if (elem % 2 == 0))
        even_counter = sum(1 for elem in nums1 if (elem % 2))
        if (odd_counter == size) or (even_counter == size):
            return True

        smallest_odd = smallest_even = math.inf
        for elem in nums1:
            if (elem % 2) and (elem < smallest_odd):
                smallest_odd = elem
            elif not (elem % 2) and (elem < smallest_even):
                smallest_even = elem

        return smallest_even > smallest_odd
