"""You can see the description of the task using the code specified in the title on leetcode.
This program has O(n) complexity by time and O(n) by space.


We can categorize the numbers based on their remainders when divided. 
The running total also has a remainder. 
If it’s 0, we can add numbers with a remainder of 1 or 2; 
if it’s 1, we can add numbers with a remainder of 1 or 0; 
if it’s 2, then 2 or 0. We can simply simulate this process in linear time. 

The only headache is the edge cases... 
whose turn it is when the simulation ends, whether any 1s or 2s are left, the remainder modulo 3... Writing all that out is tedious.
"""

# After refactoring
class Solution:
    def stoneGameIX(self, stones: List[int]) -> bool:
        cnt0 = cnt1 = cnt2 = 0
        for val in stones:
            if (typ := val % 3) == 0:
                cnt0 += 1
            elif typ == 1:
                cnt1 += 1
            else:
                cnt2 += 1
        if cnt0 % 2 == 0:
            return cnt1 >= 1 and cnt2 >= 1
        return cnt1 - cnt2 > 2 or cnt2 - cnt1 > 2


# Initial solution
class Solution:
    def stoneGameIX(self, stones: List[int]) -> bool:
        rem_0: int = 0
        rem_1: int = 0
        rem_2: int = 0

        for elem in stones:
            if not elem % 3:
                rem_0 += 1
            elif elem % 3 == 1:
                rem_1 += 1
            else:
                rem_2 += 1

        def simulate(first_1: bool) -> bool:
            rem_1_left = rem_1
            rem_2_left = rem_2

            if first_1:
                if not rem_1_left:
                    return False
                cur_rem = 1
                rem_1_left -= 1
            else:
                if not rem_2_left:
                    return False
                cur_rem = 2
                rem_2_left -= 1

            Alice_turn = False

            while (cur_rem == 1 and rem_1_left) or (cur_rem == 2 and rem_2_left):
                if cur_rem == 2:
                    cur_rem = 1
                    rem_2_left -= 1
                else:
                    cur_rem = 2
                    rem_1_left -= 1
                Alice_turn = not Alice_turn

            if not rem_1_left and not rem_2_left:
                return False

            return bool(rem_0 % 2) if Alice_turn else not bool(rem_0 % 2)

        return simulate(True) or simulate(False)
