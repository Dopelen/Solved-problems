# without sorting
class Solution:
    def minOperations(self, s: str) -> int:
        first = s[0]
        last = s[-1]
        if len(s) == 2 and first > last:
            return -1
        for ch1, ch2 in pairwise(s):
            if ch1 > ch2:
                break
        else:
            return 0

        min_ord = min(s[1:-1])
        max_ord = max(s[1:-1])

        if first <= min(last, min_ord) or last >= max(first, max_ord):
            return 1
        elif last >= min_ord or first <= max_ord:
            return 2
        return 3


# with sorting
class Solution:
    def minOperations(self, s: str) -> int:
        if list(s) == sorted(s):
            return 0
        if len(s) == 2:
            return -1
        if s[0] == min(s) or s[-1] == max(s):
            return 1
        if min(s[:-1]) > min(s) and max(s[1:]) < max(s):
            return 3
        return 2
