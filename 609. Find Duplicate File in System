"""You can see the description of the task using the code specified in the title on leetcode.
This program has O(n * l) complexity by time and O(n * l) by space.

It was very difficult to figure out what was expected of me, but I think I managed it!
Just dictionary operations - nothing complicated.
"""

class Solution:
    def findDuplicate(self, paths: List[str]) -> List[List[str]]:
        content_to_files = defaultdict(list)
        for path in paths:
            split = path.split()
            path, files = split[0], split[1:]
            for file in files:
                l, r = file.index('(') + 1, len(file) - 1
                content_to_files[file[l:r]].append(path + "/" + file[:l - 1])
        return [value for value in content_to_files.values() if len(value) > 1]
