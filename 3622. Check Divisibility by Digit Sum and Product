# without list
class Solution:
    def checkDivisibility(self, n: int) -> bool:
        s, m = 0, 1
        processed_n = n
        while processed_n:
            digit = processed_n % 10
            processed_n //= 10
            s += digit
            m *= digit
        return not n % (s + m)


# with list
class Solution:
    def checkDivisibility(self, n: int) -> bool:
        digits = []
        processed_n = n
        while processed_n:
            digits.append(processed_n % 10)
            processed_n //= 10
        return not n % (sum(digits) + functools.reduce(operator.mul, digits))

