"""You can see the description of the task using the code specified in the title on leetcode.
This program has O(n * m) complexity by time and O(n) by space.

A naive approach runs in quadratic time, and I only thought of using a bitmask after reading the hints.
Even so, it’s still not entirely clear how to implement this.
The trick is to store the frequency of the bitwise representations for each prefix. 
This makes it possible, at each prefix, to look for values ​​that yield 0 when XORed with it.
"""

# https://leetcode.com/problems/number-of-wonderful-substrings/
class Solution(object):
    def wonderfulSubstrings(self, word):
        freq = defaultdict(int)
        freq[0] = 1
        mask = 0
        result = 0
        for c in word:
            bit = ord(c) - 97
            mask ^= (1 << bit)
            if mask in freq:
                result += freq[mask]
            freq[mask] += 1

            for odd_c in range(0, 10):
                if (mask ^ (1 << odd_c)) in freq:
                    result += freq[mask ^ (1 << odd_c)]

        return result
