"""You can see the description of the task using the code specified in the title on leetcode.
This program has O(n) complexity by time and O(n) by space.

The problem has a very elegant solution using a stack - one that, 
unfortunately, I didn't come up with on my own without a hint.
"""

class Solution:
    def scoreOfParentheses(self, s: str) -> int:
        stack = [0]
        for symbol in s:
            if symbol == '(':
                stack.append(0)
            else:
                inner_score = stack.pop()
                outer_score = stack.pop()
                stack.append(outer_score + max(2 * inner_score, 1))
        return stack.pop()
