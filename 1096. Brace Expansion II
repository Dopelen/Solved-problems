"""You can see the description of the task using the code specified in the title on leetcode.
This program has O(2 ** n) complexity by time and O(2 ** n) by space.

It was a task where the objective was clear, but the actual implementation was thoroughly unpleasant.
Essentially, I just broke the required operations down into rules and applied those functions recursively.
We ended up with comma-separated lists, concatenation, and parenthesized expressions.
"""

class Solution:
    def braceExpansionII(self, expression: str) -> List[str]:
        idx = 0
        size = len(expression)

        def expr() -> set:
            nonlocal idx
            ret = set()
            while True:
                ret |= term()
                if idx < size and expression[idx] == ",":
                    idx += 1
                    continue
                else:
                    break
            return ret

        def term() -> set:
            nonlocal idx
            ret = {""}
            while idx < size and (expression[idx] == "{" or expression[idx].isalpha()):
                sub = item()
                tmp = set()
                for left in ret:
                    for right in sub:
                        tmp.add(left + right)
                ret = tmp
            return ret

        def item() -> set:
            nonlocal idx
            ret = set()
            if expression[idx] == "{":
                idx += 1
                ret = expr()
            else:
                ret = {expression[idx]}
            idx += 1
            return ret

        ret = expr()
        return sorted(list(ret))
