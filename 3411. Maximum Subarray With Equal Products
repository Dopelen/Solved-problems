# My version
class Solution:
    def maxLength(self, nums: List[int]) -> int:
        size = len(nums)
        longest = 0
        for left in range(size):
            for right in range(left + 1, size + 1):
                if math.prod(nums[left:right]) == math.gcd(*nums[left:right]) * math.lcm(*nums[left:right]):
                    longest = max(longest, right - left)
        return longest


# Leetcode versions:
class Solution:
    def maxLength(self, nums: List[int]) -> int:
        res = 2
        prod_val = 1
        n = len(nums)
        start, end = 0, 0

        while end < n:
            while gcd(prod_val, nums[end]) > 1:
                prod_val //= nums[start]
                start += 1
            prod_val *= nums[end]
            res = max(res, end - start + 1)
            end += 1

        return res
