"""You can see the description of the task using the code specified in the title on leetcode.
This program has O(m + n) complexity by time and O(m + n) by space.

I thought about a mathematical solution but couldn't come up with one. 
I wrote a simple dynamic programming solution instead.
"""

class Solution:
    def uniquePaths(self, m: int, n: int) -> int:
        row = [1] * n
        for _ in range(m - 1):
            for c in range(1, n):
                row[c] += row[c - 1]
        return row[-1]

# math one
# Any path from the top-left corner to the bottom-right corner consists of a fixed set of steps: 
# exactly m - 1 steps down and n - 1 steps right. 
# There are m + n - 2 steps in total, and the order is the only thing that distinguishes one path from another.
# In other words, a path is a sequence such as DOWN, RIGHT, RIGHT, DOWN...
# the question thus reduces to: in how many ways can we choose the m - 1 positions (out of m + n - 2) for the downward steps?

class Solution:
    def uniquePaths(self, m: int, n: int) -> int:
        return comb(m + n - 2, m - 1)
