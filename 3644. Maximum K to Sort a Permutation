"""You can see the description of the task using the code specified in the title on leetcode.
This program has O(n) complexity by time and O(1) by space.

I spent 30 minutes trying to figure out why my solution wasn't working; 
then I looked at a hint and immediately got it sorted. 
All we need to do is find the AND of all the numbers that aren't in their correct positions.
"""

class Solution:
    def sortPermutation(self, nums: List[int]) -> int:
        total_and = -1
        for i in range(len(nums)):
            if nums[i] != i:
                total_and &= i
        return 0 if total_and == -1 else total_and
