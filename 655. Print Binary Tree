"""You can see the description of the task using the code specified in the title on leetcode.
This program has O(n) complexity by time and O(h * 2 ** h) by space.

I got fed up with fiddling with the indices to find the right formula, 
but the problem itself isn't all that hard - aside from that part.
"""

class Solution:
    def printTree(self, root: TreeNode | None) -> list[list[str]]:
        
        def calculate_height(n):
            if n:
                return 1 + max(calculate_height(n.left), calculate_height(n.right))
            return 0
        
        def place_nodes(node, r, c):
            if not node:
                return
            matrix[r][c] = str(node.val)
            place_nodes(node.left, r + 1, c - 2 ** (height - r - 2))
            place_nodes(node.right, r + 1, c + 2 ** (height - r - 2))

        height = calculate_height(root)
        matrix = [['' for c in range(2 ** height - 1)] for r in range(height)]
        place_nodes(root, 0, (2 ** height - 1) // 2)
        return matrix
